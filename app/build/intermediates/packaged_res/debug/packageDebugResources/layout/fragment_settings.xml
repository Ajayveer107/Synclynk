<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <Switch
        android:id="@+id/clipboardSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable clipboard sync"
        android:checked="true"
        android:layout_marginBottom="16dp" />

    <Switch
        android:id="@+id/notificationsSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable notification mirroring"
        android:checked="true"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/notificationAccessButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open Notification Access Settings" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:text="SyncLynk stores nothing on disk except files\nyou explicitly send or receive. Closing the app\nclears the pairing and activity history." />

</LinearLayout>
